# ========================================
# VIDEO WORKER SERVICE — Environment Vars
# ========================================
# Copy file này thành .env và điền các giá trị thật

# Redis (dùng chung với NestJS)
REDIS_BROKER_URL=redis://default:YOUR_PASSWORD@redis-xxxxx.cloud.redislabs.com:xxxxx/0

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here

# Deepgram (nhận dạng giọng nói)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# FPT TTS (để trống nếu không dùng)
FPT_API_KEY=your_fpt_api_key_here

# Cloudflare R2
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=learnhub-videos-dev
R2_PUBLIC_DOMAIN=https://pub-xxxxx.r2.dev

# Webhook URL: URL public của NestJS trên Render
BACKEND_WEBHOOK_URL=https://your-nest-app.onrender.com/api/webhook/video-done

# Bảo mật nội bộ: phải khớp với INTERNAL_API_SECRET trong NestJS
INTERNAL_API_SECRET=change-this-to-a-strong-random-secret

# Celery concurrency: số video xử lý đồng thời (1 = tuần tự)
CELERY_CONCURRENCY=1
