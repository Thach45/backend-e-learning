# =============================================================================
# Biến môi trường cho docker-compose (VPS). Sao chép thành `.env` rồi điền giá trị thật.
#   cp .env.example .env
# `.env` đã nằm trong .gitignore: KHÔNG commit file thật.
# Sinh chuỗi bí mật ngẫu nhiên:  openssl rand -hex 32
# =============================================================================

# ---- Địa chỉ site ------------------------------------------------------------
# Địa chỉ công khai đầy đủ (qua nginx của VPS + HTTPS). Dùng cho CORS và redirect Google OAuth.
# Ví dụ: https://learn.example.com
PUBLIC_URL=http://localhost:8081
# Cổng loopback mà nginx của VPS proxy_pass tới (chỉ bind 127.0.0.1)
HTTP_PORT=8081
# Tùy chọn: chỉ đặt nếu API nằm ở domain khác. Mặc định "/api" (cùng domain).
# VITE_API_BASE_URL=/api
# Thông tin liên hệ ở chân trang (địa chỉ THẬT của đơn vị vận hành; để trống thì ẩn dòng đó)
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_CONTACT_ADDRESS=

# ---- Database (Postgres chạy trong compose) ----------------------------------
POSTGRES_USER=elearning
# Nên dùng chữ và số (ký tự đặc biệt như @ : / phải mã hóa URL vì nằm trong DATABASE_URL)
POSTGRES_PASSWORD=
POSTGRES_DB=elearning

# ---- Redis (chạy trong compose) ----------------------------------------------
REDIS_PASSWORD=

# ---- Backend: xác thực -------------------------------------------------------
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d
EXPIRE_OTP=5m
API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_SECRET_ID=

# ---- Backend: email và ảnh ---------------------------------------------------
# Gửi email qua Resend. API key riêng cho dự án này (quyền Sending access), domain phải đã Verified trên Resend.
RESEND_API_KEY=
# Người gửi: có dấu cách/ngoặc nhọn nên phải đặt trong dấu nháy kép
MAIL_FROM="U Đê Mê <learn@arionxai.com>"
# --- Kênh email (admin/giảng viên gửi thư cho người dùng) ---
# Hạn mức mail mỗi ngày (UTC). Gói Resend miễn phí là 100/ngày và dùng chung cả tài khoản.
MAIL_DAILY_CAP=100
# Phần hạn mức luôn dành cho mail giao dịch (OTP, đơn hàng, cảnh báo đăng nhập): chiến dịch chỉ gửi
# khi tổng số mail đã gửi hôm nay còn nhỏ hơn (MAIL_DAILY_CAP - MAIL_TRANSACTIONAL_RESERVE).
MAIL_TRANSACTIONAL_RESERVE=40
# Số chiến dịch tối đa mỗi giảng viên được nộp trong 7 ngày
INSTRUCTOR_CAMPAIGNS_PER_WEEK=3
# Người nhận bấm "Trả lời" sẽ gửi về hộp thư này (nên là hộp thư có người đọc)
MAIL_REPLY_TO=
# Địa chỉ THẬT của đơn vị vận hành, in ở cuối thư chiến dịch (để trống thì không in)
MAIL_COMPANY_ADDRESS=
# Khoá xác minh webhook Resend (Resend > Webhooks > Signing secret, dạng whsec_...). Trỏ webhook về https://<tên miền>/api/webhooks/resend
RESEND_WEBHOOK_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER_NAME=online-learning

# ---- Thanh toán SePay --------------------------------------------------------
PAYMENT_PROVIDER=sepay
SO_TAI_KHOAN=
NGAN_HANG=MBBank
# Token gọi API SePay (lấy danh sách giao dịch)
SEPAY_API_KEY=
# Khóa SePay gửi kèm webhook (header "Authorization: Apikey <khóa>"): dán CÙNG giá trị vào cấu hình webhook trên SePay
SEPAY_WEBHOOK_API_KEY=
# Số phút được thanh toán sau khi tạo đơn; quá hạn đơn tự hủy và mã giảm giá được hoàn lại
ORDER_PAYMENT_TIMEOUT_MINUTES=10

# ---- Video: Cloudflare R2 (dùng chung backend và worker) ---------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=https://pub-xxxxx.r2.dev
# Bí mật nội bộ giữa backend và video worker (phải mạnh, ngẫu nhiên)
INTERNAL_API_SECRET=

# ---- Video worker: AI --------------------------------------------------------
GEMINI_API_KEY=
DEEPGRAM_API_KEY=
# Để trống nếu không dùng FPT TTS
FPT_API_KEY=
# Số video xử lý đồng thời
CELERY_CONCURRENCY=1

# ---- Tài khoản admin đầu tiên (chạy initialScript/seed.ts, xem DEPLOY.md) ----
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
