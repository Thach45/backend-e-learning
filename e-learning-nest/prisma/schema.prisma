generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum VerificationType {
  REGISTER
  FORGOT_PASSWORD
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  PENDING_PUBLISHED
  PENDING_DRAFT
}

enum StorageType {
  YOUTUBE
  GOOGLE_DRIVE
  CLOUDINARY
  DIRECT_UPLOAD
  CLOUDFLARE_R2
  OTHER
}

enum MaterialType {
  PDF
  DOC
  PPT
  ZIP
  LINK
  OTHER
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
}

enum ContentType {
  SECTION
  LESSON
}

enum ROLES {
  ADMIN
  CLIENT
  INSTRUCTOR
}

enum NotificationType {
  SYSTEM // Thông báo hệ thống chung
  COURSE_ENROLL // Đăng ký khóa học thành công
  NEW_COMMENT // Có bình luận mới trong bài học
  NEW_REPLY // Có trả lời mới cho bình luận
  ORDER_STATUS // Cập nhật trạng thái đơn hàng
  LEARNING_PROGRESS // Hoàn thành bài học/khóa
  NEW_QUESTION // Có câu hỏi mới trong bài học
  NEW_ANSWER // Có câu trả lời mới cho câu hỏi
}

enum ReportTargetType {
  COMMENT
  LESSON_QUESTION
  LESSON_ANSWER
  REVIEW
}

enum ReportReason {
  SPAM
  INAPPROPRIATE
  HARASSMENT
  MISLEADING
  OTHER
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum PaymentTxOutcome {
  PAID // Khớp đơn PENDING, đã chốt PAID và ghi danh
  ALREADY_PAID // Đơn đã PAID trước đó (ví dụ đã chốt bằng luồng kiểm tra thủ công)
  ORDER_NOT_PENDING // Khớp đơn nhưng đơn không còn PENDING (ví dụ FAILED): cần xử lý tay
  AMOUNT_MISMATCH // Khớp đơn nhưng số tiền không đúng: cần xử lý tay
  ORDER_NOT_FOUND // Nội dung có mã đơn nhưng không có đơn nào
  NO_ORDER_REF // Nội dung chuyển khoản không có mã đơn
  WRONG_ACCOUNT // Giao dịch vào tài khoản khác với tài khoản cấu hình
  IGNORED // Không phải tiền vào
}

enum CouponType {
  PERCENT // value = % giảm (1-100)
  FIXED // value = số tiền giảm cố định
}

enum NotificationStatus {
  UNREAD
  READ
}

// Core models for authentication and RBAC
model Role {
  id          String    @id @default(uuid())
  name        ROLES     @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  // RBAC
  rolePermissions RolePermission[]
  userRoles       UserRole[]
}

model User {
  id          String     @id @default(uuid())
  email       String     @unique
  password    String
  name        String
  phoneNumber String
  avatar      String?
  totpSecret  String?
  status      UserStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  devices       Device[]
  refreshTokens RefreshToken[]
  userRoles     UserRole[]

  // E-learning
  instructorCourses  Course[]           @relation("InstructorCourses")
  enrollments        Enrollment[]
  reviews            Review[]
  comments           Comment[]
  orders             Order[]
  wishlists          Wishlist[]
  learningProgresses LearningProgress[]
  cart               Cart?

  // Community/Documents
  uploadedMaterials SupplementaryMaterial[] @relation("UserUploads")
  documentLikes     UserDocumentLike[]
  documentDownloads UserDocumentDownload[]
  documentViews     UserDocumentView[]
  notifications     Notification[]

  instructorProfile    InstructorProfile?
  instructorFollowers  InstructorFollow[]     @relation("InstructorFollowers")
  followingInstructors InstructorFollow[]     @relation("FollowerUsers")
  commentReactions     CommentReaction[]
  badges               UserBadge[]
  auditLogs            AuditLog[]
  lessonNotes          LessonNote[]
  lessonQuestions      LessonQuestion[]
  lessonAnswers        LessonAnswer[]
  quizAttempts         QuizAttempt[]
  surveyResponses      CourseSurveyResponse[]
  reportsFiled         ContentReport[]        @relation("ReportsFiled")
  reportsHandled       ContentReport[]        @relation("ReportsHandled")
  couponRedemptions    CouponRedemption[]
}

enum BadgeCode {
  FIRST_COURSE_COMPLETED
  FIVE_COURSES_COMPLETED
  STREAK_7_DAYS
  STREAK_30_DAYS
  FIRST_REVIEW
}

model Badge {
  id          String    @id @default(uuid())
  code        BadgeCode @unique
  name        String
  description String
  icon        String?
  createdAt   DateTime  @default(now())

  users UserBadge[]
}

model UserBadge {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  awardedAt DateTime @default(now())

  @@unique([userId, badgeId])
  @@index([userId])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model InstructorProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title             String?
  bio               String?
  expertise         String[] @default([])
  yearsOfExperience Int?
  websiteUrl        String?
  linkedinUrl       String?
  githubUrl         String?
  youtubeUrl        String?
  facebookUrl       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
}

model InstructorFollow {
  id           String   @id @default(uuid())
  instructorId String
  instructor   User     @relation("InstructorFollowers", fields: [instructorId], references: [id], onDelete: Cascade)
  followerId   String
  follower     User     @relation("FollowerUsers", fields: [followerId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@unique([instructorId, followerId])
  @@index([instructorId])
  @@index([followerId])
}

model Device {
  id           String   @id @default(uuid())
  userId       String
  userAgent    String
  ipAddress    String
  lastActiveAt DateTime
  isActive     Boolean

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokens RefreshToken[]
}

model RefreshToken {
  token     String   @id
  userId    String
  deviceId  String
  expiresAt DateTime

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}

model VerificationCode {
  email     String
  code      String
  type      VerificationType
  expiresAt DateTime
  createdAt DateTime         @default(now())

  @@id([email, type, code])
  @@index([email, type])
}

// RBAC Permissions
model Permission {
  id          String    @id @default(uuid())
  name        String
  description String?
  path        String
  method      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdBy   String?
  updatedBy   String?

  roles RolePermission[]

  @@unique([path, method], map: "path_method")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId], map: "roleId_permissionId")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId], map: "userId_roleId")
}

// E-learning Models

model Category {
  id        String     @id @default(uuid())
  name      String
  imageUrl  String?
  parentId  String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  isActive  Boolean    @default(true)
  parent    Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryParent")
  courses   Course[]

  @@unique([name, parentId])
}

model Course {
  id    String @id @default(uuid())
  title String

  courseDetail           CourseDetail?
  price                  Float                   @default(0)
  salePrice              Float?
  thumbnail              String?
  introVideo             String?
  isFeatured             Boolean                 @default(false)
  level                  CourseLevel             @default(BEGINNER)
  language               String                  @default("vi") // mã ngôn ngữ của khoá học
  status                 CourseStatus            @default(DRAFT)
  instructor             User                    @relation("InstructorCourses", fields: [instructorId], references: [id])
  instructorId           String
  category               Category?               @relation(fields: [categoryId], references: [id])
  categoryId             String?
  courseContents         CourseContent[]
  supplementaryMaterials SupplementaryMaterial[]
  enrollments            Enrollment[]
  reviews                Review[]
  wishlists              Wishlist[]
  orderItems             OrderItem[]
  notifications          Notification[]
  learningProgresses     LearningProgress[]
  cartItems              CartItem[]
  surveyResponses        CourseSurveyResponse[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  deletedAt              DateTime?
  createdBy              String?
  updatedBy              String?
  isActive               Boolean                 @default(true)

  @@index([title])
  @@index([price])
  @@index([level])
  @@index([status])
  @@index([isFeatured])
  @@index([instructorId]) // Rất quan trọng (FK)
  @@index([categoryId]) // Rất quan trọng (FK)
  @@index([createdAt]) // Rất quan trọng (để sort "mới nhất")
}

model CourseDetail {
  id             String   @id @default(uuid())
  courseId       String   @unique
  course         Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  description    String?
  content        String?
  objectives     String?
  requirements   String?
  targetAudience String?
  benefits       String?
  relatedCourses String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([courseId])
}

model CourseContent {
  id         String          @id @default(uuid())
  course     Course          @relation(fields: [courseId], references: [id])
  courseId   String
  parentId   String?
  parent     CourseContent?  @relation("ContentParent", fields: [parentId], references: [id])
  children   CourseContent[] @relation("ContentParent")
  title      String
  orderIndex Int             @default(0)
  lessons    Lesson[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  deletedAt  DateTime?
  createdBy  String?
  updatedBy  String?
  isActive   Boolean         @default(true)

  @@index([courseId])
  @@index([parentId])
  @@index([orderIndex])
  @@index([isActive])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([deletedAt])
  @@index([createdBy])
  @@index([updatedBy])
  @@index([title])
}

model Lesson {
  id                     String                  @id @default(uuid())
  content                CourseContent           @relation(fields: [contentId], references: [id])
  contentId              String
  title                  String
  storageType            StorageType
  storageUrl             String?
  contentText            String?
  duration               Int? // seconds
  transcript             String? // Bản chép lời/phụ đề dạng văn bản thuần
  isPreview              Boolean                 @default(false) // cho xem thử miễn phí khi chưa mua
  supplementaryMaterials SupplementaryMaterial[]
  comments               Comment[]
  learningProgresses     LearningProgress[]
  notifications          Notification[]
  notes                  LessonNote[]
  questions              LessonQuestion[]
  quiz                   Quiz?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime?               @updatedAt
  deletedAt              DateTime?
  createdBy              String?
  updatedBy              String?
  isActive               Boolean                 @default(true)

  @@index([contentId])
  @@index([title])
  @@index([storageType])
  @@index([storageUrl])
}

model SupplementaryMaterial {
  id             String          @id @default(uuid())
  title          String
  lesson         Lesson?         @relation(fields: [lessonId], references: [id])
  lessonId       String?
  course         Course?         @relation(fields: [courseId], references: [id])
  courseId       String?
  materialType   MaterialType
  url            String
  uploadedAt     DateTime        @default(now())
  materialDetail MaterialDetail?

  // Community/Documents
  uploader   User?                  @relation("UserUploads", fields: [uploaderId], references: [id])
  uploaderId String?
  category   DocumentCategory?      @relation(fields: [categoryId], references: [id])
  categoryId String?
  likes      UserDocumentLike[]
  downloads  UserDocumentDownload[]
  views      UserDocumentView[]

  @@index([uploaderId])
  @@index([categoryId])
  @@index([uploadedAt])
}

model MaterialDetail {
  id            String                @id @default(uuid())
  materialId    String                @unique
  schoolName    String? // Optional: chỉ cần cho Community documents, không bắt buộc cho course/lesson materials
  totalDownload Int                   @default(0)
  totalView     Int                   @default(0)
  totalLike     Int                   @default(0)
  material      SupplementaryMaterial @relation(fields: [materialId], references: [id])
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  deletedAt     DateTime?
  createdBy     String?
  updatedBy     String?
  isActive      Boolean               @default(true)

  // Community/Documents fields (all optional)
  pages      Int? // Số trang - chỉ cần cho Community documents
  thumbnail  String? // Ảnh preview - chỉ cần cho Community documents
  subject    String? // Môn học - chỉ cần cho Community documents
  isVerified Boolean @default(false) // Badge uy tín - chỉ cần cho Community documents

  // Relation to DocumentTag (many-to-many)
  documentTags DocumentTagOnMaterial[]

  @@index([materialId])
  @@index([schoolName])
  @@index([totalDownload])
  @@index([totalView])
  @@index([totalLike])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([deletedAt])
  @@index([createdBy])
  @@index([updatedBy])
  @@index([isActive])
  @@index([pages])
  @@index([subject])
  @@index([isVerified])
}

// Document Tag - Từ khóa nổi bật cho tài liệu cộng đồng
model DocumentTag {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  color       String? // Màu hiển thị (hex color)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relation to MaterialDetail (many-to-many)
  materials DocumentTagOnMaterial[]

  @@index([name])
  @@index([slug])
  @@index([isActive])
  @@index([sortOrder])
}

// Junction table for DocumentTag <-> MaterialDetail
model DocumentTagOnMaterial {
  id               String         @id @default(uuid())
  materialDetail   MaterialDetail @relation(fields: [materialDetailId], references: [id], onDelete: Cascade)
  materialDetailId String
  documentTag      DocumentTag    @relation(fields: [documentTagId], references: [id], onDelete: Cascade)
  documentTagId    String
  createdAt        DateTime       @default(now())

  @@unique([materialDetailId, documentTagId])
  @@index([materialDetailId])
  @@index([documentTagId])
}

model Enrollment {
  id          String    @id @default(uuid())
  user        User      @relation(fields: [userId], references: [id])
  userId      String
  course      Course    @relation(fields: [courseId], references: [id])
  courseId    String
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?

  @@unique([userId, courseId])
}

model LearningProgress {
  id              String   @id @default(uuid())
  user            User     @relation(fields: [userId], references: [id])
  userId          String
  course          Course   @relation(fields: [courseId], references: [id])
  courseId        String
  lesson          Lesson   @relation(fields: [lessonId], references: [id])
  lessonId        String
  progressPercent Int      @default(0)
  lastAccessed    DateTime @default(now())

  @@unique([userId, courseId, lessonId])
}

model Review {
  id                String    @id @default(uuid())
  user              User      @relation(fields: [userId], references: [id])
  userId            String
  course            Course    @relation(fields: [courseId], references: [id])
  courseId          String
  rating            Int
  comment           String?
  instructorReply   String?
  instructorReplyAt DateTime?
  createdAt         DateTime  @default(now())

  @@unique([userId, courseId])
}

model Comment {
  id            String            @id @default(uuid())
  user          User              @relation(fields: [userId], references: [id])
  userId        String
  lesson        Lesson            @relation(fields: [lessonId], references: [id])
  lessonId      String
  content       String
  parentId      String? // Thêm field này
  parent        Comment?          @relation("CommentReplies", fields: [parentId], references: [id])
  replies       Comment[]         @relation("CommentReplies") // Thêm relation
  notifications Notification[]
  reactions     CommentReaction[]
  createdAt     DateTime          @default(now())
}

enum ReactionType {
  LIKE
  LOVE
  HELPFUL
}

model CommentReaction {
  id        String       @id @default(uuid())
  commentId String
  comment   Comment      @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ReactionType @default(LIKE)
  createdAt DateTime     @default(now())

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
}

model Order {
  id                  String               @id @default(uuid())
  user                User                 @relation(fields: [userId], references: [id])
  userId              String
  totalAmount         Float
  status              OrderStatus          @default(PENDING)
  orderItems          OrderItem[]
  notifications       Notification[]
  coupon              Coupon?              @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponId            String?
  couponCode          String? // Snapshot mã tại thời điểm đặt đơn
  discountAmount      Float                @default(0) // Số tiền đã giảm (totalAmount = tổng gốc - discountAmount)
  createdAt           DateTime             @default(now())
  paymentTransactions PaymentTransaction[]
  expiresAt           DateTime? // Hạn thanh toán; quá hạn mà chưa PAID thì đơn bị hủy (FAILED)
  couponRedemption    CouponRedemption?

  @@index([couponId])
}

model OrderItem {
  id       String @id @default(uuid())
  order    Order  @relation(fields: [orderId], references: [id])
  orderId  String
  course   Course @relation(fields: [courseId], references: [id])
  courseId String
  price    Float
}

model Wishlist {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  course    Course   @relation(fields: [courseId], references: [id])
  courseId  String
  createdAt DateTime @default(now())

  @@unique([userId, courseId])
}

model Cart {
  id        String     @id @default(uuid())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String     @unique
  cartItems CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  expiresAt DateTime? // Tự động xóa sau 30 ngày không hoạt động

  @@index([userId])
  @@index([expiresAt])
}

model CartItem {
  id        String   @id @default(uuid())
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId    String
  course    Course   @relation(fields: [courseId], references: [id])
  courseId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, courseId])
  @@index([cartId])
  @@index([courseId])
}

// Community/Documents Models

model DocumentCategory {
  id          String                  @id @default(uuid())
  name        String
  description String?
  slug        String?                 @unique
  icon        String?
  isActive    Boolean                 @default(true)
  documents   SupplementaryMaterial[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  deletedAt   DateTime?

  @@index([name])
  @@index([slug])
  @@index([isActive])
}

model UserDocumentLike {
  id         String                @id @default(uuid())
  userId     String
  materialId String
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  material   SupplementaryMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  createdAt  DateTime              @default(now())

  @@unique([userId, materialId])
  @@index([userId])
  @@index([materialId])
  @@index([createdAt])
}

model UserDocumentDownload {
  id           String                @id @default(uuid())
  userId       String?
  materialId   String
  user         User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  material     SupplementaryMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  downloadedAt DateTime              @default(now())
  ipAddress    String? // Track anonymous downloads

  @@index([materialId])
  @@index([userId])
  @@index([downloadedAt])
  @@index([ipAddress])
}

model UserDocumentView {
  id         String                @id @default(uuid())
  userId     String?
  materialId String
  user       User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  material   SupplementaryMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  viewedAt   DateTime              @default(now())
  ipAddress  String? // Track anonymous views
  duration   Int? // Thời gian xem (seconds)

  @@index([materialId])
  @@index([userId])
  @@index([viewedAt])
  @@index([ipAddress])
}

model Notification {
  id        String             @id @default(uuid())
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      NotificationType
  title     String
  message   String
  data      Json? // payload thêm: { courseId, lessonId, ... }
  course    Course?            @relation(fields: [courseId], references: [id])
  courseId  String?
  lesson    Lesson?            @relation(fields: [lessonId], references: [id])
  lessonId  String?
  order     Order?             @relation(fields: [orderId], references: [id])
  orderId   String?
  comment   Comment?           @relation(fields: [commentId], references: [id])
  commentId String?
  status    NotificationStatus @default(UNREAD)
  readAt    DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  deletedAt DateTime?

  @@index([userId, status])
  @@index([userId, createdAt])
}

// ===== Phase 3 =====

model LessonNote {
  id               String   @id @default(uuid())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String
  lesson           Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId         String
  content          String
  timestampSeconds Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId, lessonId])
  @@index([lessonId])
}

model LessonQuestion {
  id         String         @id @default(uuid())
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  lesson     Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId   String
  title      String
  content    String
  isResolved Boolean        @default(false)
  answers    LessonAnswer[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([lessonId])
  @@index([userId])
}

model LessonAnswer {
  id                 String         @id @default(uuid())
  question           LessonQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId         String
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String
  content            String
  isInstructorAnswer Boolean        @default(false)
  createdAt          DateTime       @default(now())

  @@index([questionId])
}

model Quiz {
  id           String         @id @default(uuid())
  lesson       Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId     String         @unique
  title        String
  passingScore Int            @default(70) // % câu đúng tối thiểu để đạt
  questions    QuizQuestion[]
  attempts     QuizAttempt[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model QuizQuestion {
  id         String       @id @default(uuid())
  quiz       Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  quizId     String
  text       String
  orderIndex Int          @default(0)
  options    QuizOption[]
  answers    QuizAnswer[]

  @@index([quizId])
}

model QuizOption {
  id         String       @id @default(uuid())
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId String
  text       String
  isCorrect  Boolean      @default(false)
  answers    QuizAnswer[]

  @@index([questionId])
}

model QuizAttempt {
  id           String       @id @default(uuid())
  quiz         Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  quizId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  scorePercent Int
  passed       Boolean
  answers      QuizAnswer[]
  submittedAt  DateTime     @default(now())

  @@index([quizId, userId])
  @@index([userId])
}

model QuizAnswer {
  id         String       @id @default(uuid())
  attempt    QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  attemptId  String
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId String
  option     QuizOption   @relation(fields: [optionId], references: [id], onDelete: Cascade)
  optionId   String

  @@unique([attemptId, questionId])
  @@index([attemptId])
}

model CourseSurveyResponse {
  id                 String   @id @default(uuid())
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String
  course             Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId           String
  difficultyRating   Int // 1-5
  satisfactionRating Int // 1-5
  wouldRecommend     Boolean
  feedback           String?
  createdAt          DateTime @default(now())

  @@unique([userId, courseId])
  @@index([courseId])
}

// Báo cáo vi phạm nội dung (bình luận, hỏi đáp, đánh giá)
model ContentReport {
  id              String           @id @default(uuid())
  reporter        User             @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  reporterId      String
  targetType      ReportTargetType
  targetId        String
  reason          ReportReason
  details         String?
  contentSnapshot String? // Nội dung tại thời điểm báo cáo (vẫn xem được sau khi nội dung bị gỡ)
  targetAuthorId  String? // Tác giả nội dung bị báo cáo
  targetContext   String? // Ngữ cảnh: khóa học / bài học chứa nội dung
  status          ReportStatus     @default(PENDING)
  handledBy       User?            @relation("ReportsHandled", fields: [handledById], references: [id], onDelete: SetNull)
  handledById     String?
  handledAt       DateTime?
  resolutionNote  String?
  contentRemoved  Boolean          @default(false)
  createdAt       DateTime         @default(now())

  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt])
  @@index([targetType, targetId])
}

// Mã giảm giá
model Coupon {
  id             String             @id @default(uuid())
  code           String             @unique // Luôn lưu chữ HOA
  description    String?
  type           CouponType
  value          Float
  maxDiscount    Float? // Chỉ áp dụng cho PERCENT: trần số tiền giảm
  minOrderAmount Float? // Giá trị đơn tối thiểu (tính trên phần khóa học hợp lệ)
  startsAt       DateTime?
  expiresAt      DateTime?
  usageLimit     Int? // Tổng số lượt dùng tối đa (null = không giới hạn)
  perUserLimit   Int                @default(1)
  courseIds      String[]           @default([]) // Rỗng = áp dụng mọi khóa học
  isActive       Boolean            @default(true)
  createdById    String?
  orders         Order[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  redemptions    CouponRedemption[]

  @@index([isActive])
  @@index([expiresAt])
}

// Giao dịch ngân hàng nhận từ webhook của cổng thanh toán (SePay). Dùng để chống xử lý trùng và đối soát.
model PaymentTransaction {
  id            String           @id @default(uuid())
  provider      String           @default("sepay")
  providerTxId  String // ID giao dịch phía cổng thanh toán (SePay `id`)
  order         Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId       String?
  amount        Float
  transferType  String
  content       String?
  accountNumber String?
  referenceCode String?
  outcome       PaymentTxOutcome
  raw           Json
  createdAt     DateTime         @default(now())

  @@unique([provider, providerTxId])
  @@index([orderId])
  @@index([outcome])
}

// Mỗi lần dùng mã giảm giá = một dòng. Đơn bị hủy/hết hạn thì XÓA dòng này (trả lại lượt).
// Số lượt đã dùng của mã = số dòng; số lượt của một người = số dòng của người đó.
model CouponRedemption {
  id             String   @id @default(uuid())
  coupon         Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  couponId       String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId        String   @unique
  slot           Int // 1..perUserLimit; ràng buộc duy nhất chặn một người dùng quá số lượt kể cả khi gửi song song
  discountAmount Float
  createdAt      DateTime @default(now())

  @@unique([couponId, userId, slot])
  @@index([couponId])
}


// ===== Cài đặt hệ thống (một dòng duy nhất: link mạng xã hội + chế độ bảo trì) =====

model SiteSetting {
  id                 String    @id @default("singleton")
  facebookUrl        String?
  instagramUrl       String?
  twitterUrl         String?
  youtubeUrl         String?
  linkedinUrl        String?
  tiktokUrl          String?
  zaloUrl            String?
  maintenanceEnabled Boolean   @default(false)
  maintenanceMessage String?   @db.VarChar(500)
  maintenanceUntil   DateTime? // dự kiến mở lại, chỉ để hiển thị
  updatedById        String?
  updatedAt          DateTime  @updatedAt
}
